DATABASE_URL=postgresql://postgres:postgres@localhost:5432/umbrella-backend
PORT=3030
# JWT Configuration
JWT_SECRET=local-dev-secret-key-change-me
JWT_EXPIRY=30m
JWT_ISSUER=nestjs-auth-service
JWT_PRIVATE_KEY=local-dev-private-key

# Twilio Configuration (for SMS validation)
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_VERIFY_SID=your-twilio-verify-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here

# Security Configuration
SALT_ROUND=10

JWT_ISSUER=umbrella-backend.local.paisamex.mx
ONESIGNAL_APP_ID=***REDACTED-ONESIGNAL-APP-ID***
ONESIGNAL_REST_API_KEY=***REDACTED-ONESIGNAL-API-KEY***
# Amazon S3
AWS_BUCKET_NAME=umbrella-uploads-local
AWS_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
S3_EXPIRES_TIMEOUT=3600
DOCUMENT_PROVIDER_NAME=S3
